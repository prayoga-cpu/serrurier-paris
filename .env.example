# Copy to .env.local for development. Neither value is committed.

# GTM container. Unset = no analytics injected at all, no consent banner, no
# dataLayer (deliberate: a placeholder ID would look like working analytics).
NEXT_PUBLIC_GTM_ID=

# Sample reviews for layout work ONLY. Never set this in a production build:
# publishing invented reviews as if they were real is a pratique commerciale
# trompeuse under the Code de la consommation. Real reviews go in
# VERIFIED_REVIEWS in lib/testimonials.ts, and render regardless of this flag.
NEXT_PUBLIC_SHOW_SAMPLE_REVIEWS=true
