# Copy to .env.local for development. Neither value is committed.

# GTM container. Unset = no analytics injected at all, no consent banner, no
# dataLayer (deliberate: a placeholder ID would look like working analytics).
NEXT_PUBLIC_GTM_ID=

# Sample reviews for layout work ONLY. Never set this in a production build:
# publishing invented reviews as if they were real is a pratique commerciale
# trompeuse under the Code de la consommation. Real reviews go in
# VERIFIED_REVIEWS in lib/testimonials.ts, and render regardless of this flag.
NEXT_PUBLIC_SHOW_SAMPLE_REVIEWS=true

# --- Email (Resend) ----------------------------------------------------------
# Server-side only — never prefix these NEXT_PUBLIC_. Unset = /api/submit
# returns 503 and sends nothing; the forms still work, because WhatsApp is
# still opened client-side.
RESEND_API_KEY=

# Optional. Sender identity, which MUST be a domain verified in the Resend
# account. Defaults to the client's brand name over PRIONATION's verified
# prionation.io domain, because parisunlockdoor.fr is not verified in Resend
# yet. Set this to "Serrurier Paris Express <devis@parisunlockdoor.fr>" once
# it is, and nothing else needs to change.
MAIL_FROM=

# Optional, comma-separated. Who gets notified of every submission. Defaults
# to consult@prionation.io + the EMAIL constant in lib/config.ts. Override it
# in local/preview environments so test submissions don't reach the client.
MAIL_TEAM_RECIPIENTS=
